@kernel void mdsRhsBCLaplacianTet3D(const dlong Nelements,
                                    @restrict const  dfloat *  wJ,
                                    @restrict const  dfloat *  ggeo,
                                    @restrict const  dfloat *  sgeo,
                                    @restrict const  dfloat *  vgeo,
                                    @restrict const  dfloat *  D,
                                    @restrict const  dfloat *  S,
                                    @restrict const  dfloat *  Se,
                                    @restrict const  dfloat *  MM,
                                    @restrict const  dlong  *  vmapM,
                                    @restrict const  dfloat *  sM,
                                    const dfloat lambda,
                                    const dfloat mu,
                                    @restrict const  dfloat *  x,
                                    @restrict const  dfloat *  y,
                                    @restrict const  dfloat *  z,
                                    @restrict const  int    *  mapB,
                                    @restrict dfloat  *  rhsx,
                                    @restrict dfloat  *  rhsy,
                                    @restrict dfloat  *  rhsz){

  for(int e=0;e<Nelements;e++;@outer(0)){
    @shared dfloat s_qx[p_Np];
    @shared dfloat s_qy[p_Np];
    @shared dfloat s_qz[p_Np];

    for(int n=0;n<p_Nmax;++n;@inner(0)){
      if(n<p_Np){
        for(int fld=0;fld<p_Nfields;fld++){
          s_qx[n] = 0.;
          s_qy[n] = 0.;
          s_qz[n] = 0.;
        }
      }
    }
    
    for(int n=0;n<p_Nmax;++n;@inner(0)){
      if(n<p_NfacesNfp){
        const int id  = n + e*p_Nfaces*p_Nfp;
        const int idM = vmapM[id];
        const int nid = idM%p_Np;

        dfloat uP=0., vP=0., wP=0.;

        const int bc = mapB[idM];
        if(bc>0){
          mdsBoundaryConditions3D(bc, x[idM], y[idM], z[idM],
                                  uP, vP, wP);
        }
        s_qx[nid] = uP;
        s_qy[nid] = vP;
        s_qz[nid] = wP;
      }
    }

    for(int n=0;n<p_Nmax;++n;@inner(0)){
      if(n<p_Np){
        // volume Dirichlet data
        const int gid = e*p_Nggeo;
        const dfloat Grr = ggeo[gid + p_G00ID];
        const dfloat Grs = ggeo[gid + p_G01ID];
        const dfloat Grt = ggeo[gid + p_G02ID];
        const dfloat Gss = ggeo[gid + p_G11ID];
        const dfloat Gst = ggeo[gid + p_G12ID];
        const dfloat Gtt = ggeo[gid + p_G22ID];

        // contributions for x
        dfloat qrr_x = 0.;
        dfloat qrs_x = 0.;
        dfloat qrt_x = 0.;
        dfloat qss_x = 0.;
        dfloat qst_x = 0.;
        dfloat qtt_x = 0.;

        // contributions for y
        dfloat qrr_y = 0.;
        dfloat qrs_y = 0.;
        dfloat qrt_y = 0.;
        dfloat qss_y = 0.;
        dfloat qst_y = 0.;
        dfloat qtt_y = 0.;

        // contributions for z
        dfloat qrr_z = 0.;
        dfloat qrs_z = 0.;
        dfloat qrt_z = 0.;
        dfloat qss_z = 0.;
        dfloat qst_z = 0.;
        dfloat qtt_z = 0.;

        #pragma unroll p_Np
          for (int k=0;k<p_Np;k++) {
            qrr_x += S[n+k*p_Np+0*p_Np*p_Np]*s_qx[k];
            qrs_x += S[n+k*p_Np+1*p_Np*p_Np]*s_qx[k];
            qrt_x += S[n+k*p_Np+2*p_Np*p_Np]*s_qx[k];
            qss_x += S[n+k*p_Np+3*p_Np*p_Np]*s_qx[k];
            qst_x += S[n+k*p_Np+4*p_Np*p_Np]*s_qx[k];
            qtt_x += S[n+k*p_Np+5*p_Np*p_Np]*s_qx[k];

            qrr_y += S[n+k*p_Np+0*p_Np*p_Np]*s_qy[k];
            qrs_y += S[n+k*p_Np+1*p_Np*p_Np]*s_qy[k];
            qrt_y += S[n+k*p_Np+2*p_Np*p_Np]*s_qy[k];
            qss_y += S[n+k*p_Np+3*p_Np*p_Np]*s_qy[k];
            qst_y += S[n+k*p_Np+4*p_Np*p_Np]*s_qy[k];
            qtt_y += S[n+k*p_Np+5*p_Np*p_Np]*s_qy[k];

            qrr_z += S[n+k*p_Np+0*p_Np*p_Np]*s_qz[k];
            qrs_z += S[n+k*p_Np+1*p_Np*p_Np]*s_qz[k];
            qrt_z += S[n+k*p_Np+2*p_Np*p_Np]*s_qz[k];
            qss_z += S[n+k*p_Np+3*p_Np*p_Np]*s_qz[k];
            qst_z += S[n+k*p_Np+4*p_Np*p_Np]*s_qz[k];
            qtt_z += S[n+k*p_Np+5*p_Np*p_Np]*s_qz[k];
            
          }

        const dlong id = n+e*p_Np;
        rhsx[id] -= Grr*qrr_x+Grs*qrs_x+Grt*qrt_x+Gss*qss_x+Gst*qst_x+Gtt*qtt_x;
        rhsy[id] -= Grr*qrr_y+Grs*qrs_y+Grt*qrt_y+Gss*qss_y+Gst*qst_y+Gtt*qtt_y;
        rhsz[id] -= Grr*qrr_z+Grs*qrs_z+Grt*qrt_z+Gss*qss_z+Gst*qst_z+Gtt*qtt_z;
      }
    }
  }
}