#define p_blockSize 256

// Compute the relative Jacobian o_wJRel = o_wJ / o_wJ0 for each element/node
@kernel void relativeJacobianTri2D(const dlong Nelements,
                                       @restrict const dfloat *  wJ,
                                       @restrict const dfloat *  wJ0,
                                       @restrict       dfloat *  wJRel){

  for(dlong e=0;e<Nelements;++e;@tile(p_blockSize,@outer,@inner)){
    
    wJRel[e] = wJ[e]/wJ0[e];
  }
}
