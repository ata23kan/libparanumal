@kernel void interpolateVelocityTri2D(const dlong Nelements,
																			const dfloat invaleT,
																			@restrict const dfloat *  IM,
																			@restrict       dfloat *  dx,
																			@restrict       dfloat *  dy,
																			@restrict       dfloat *  x,
																			@restrict       dfloat *  y,
																			@restrict       dfloat *  z,
																			@restrict       dfloat *  meshVelx,
																			@restrict       dfloat *  meshVely){

	for(int e=0;e<Nelements;e++;@outer(0)){

		@shared dfloat s_dx[p_NpN1];
		@shared dfloat s_dy[p_NpN1];

		for(int n=0;n<p_Np;++n;@inner(0)){
			if(n<p_NpN1){
				const dlong id = n + e*p_NpN1;
				s_dx[n] = dx[id];
				s_dy[n] = dy[id];
			}
		}

		for(int n=0;n<p_Np;++n;@inner(0)){

			dfloat mQ_x = 0.;
			dfloat mQ_y = 0.;

			#pragma unroll p_NpN1
				for(int i=0;i<p_NpN1;i++){
					mQ_x += IM[i+n*p_NpN1]*s_dx[i];
					mQ_y += IM[i+n*p_NpN1]*s_dy[i];
				}

			const dlong id = e*p_Np + n;
			meshVelx[id] = mQ_x*invaleT;
			meshVely[id] = mQ_y*invaleT;
		}

	}  // end element loop
}		 // end velocity interpolation kernel


@kernel void interpolatePositionTri2D(const dlong Nelements,
																			const dfloat invaleT,
																			@restrict const dfloat *  IM,
																			@restrict       dfloat *  dx,
																			@restrict       dfloat *  dy,
																			@restrict       dfloat *  N1x,
																			@restrict       dfloat *  N1y,
																			@restrict       dfloat *  N1z,
																			@restrict       dfloat *  x,
																			@restrict       dfloat *  y,
																			@restrict       dfloat *  z){

	for(int e=0;e<Nelements;e++;@outer(0)){

		@shared dfloat s_dx[p_NpN1];
		@shared dfloat s_dy[p_NpN1];

		for(int n=0;n<p_Np;++n;@inner(0)){
			if(n<p_NpN1){
				const dlong id = n + e*p_NpN1;
				s_dx[n] = dx[id];
				s_dy[n] = dy[id];

				N1x[id] += dx[id];
				N1y[id] += dx[id];
			}
		}

		for(int n=0;n<p_Np;++n;@inner(0)){

			dfloat mQ_x = 0.;
			dfloat mQ_y = 0.;

			#pragma unroll p_NpN1
				for(int i=0;i<p_NpN1;i++){
					mQ_x += IM[i+n*p_NpN1]*s_dx[i];
					mQ_y += IM[i+n*p_NpN1]*s_dy[i];
				}

			const dlong id = e*p_Np + n;
			x[id] += mQ_x;
			y[id] += mQ_y;

		}
	}
}
